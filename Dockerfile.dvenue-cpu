# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# D-Chain VENUE image (CPU, linux/amd64) — ghcr.io/luxfi/dchain
#
# The pure-Go CPU sealing venue for devnet. cmd/dvenue is matcher-agnostic;
# CGO_ENABLED=0 selects pkg/lx's pure-Go CPU matcher (amm_nogpu /
# orderbook_cuda_stub via the !cgo build tag in engine_nocgo.go). No CUDA,
# no GPU tarball — runs on any amd64 node. This is the binary the deployed
# `dchain-venue` Deployment runs as `dvenue -addr 0.0.0.0:9099 -db /data/db`:
# it opens the persisted zapdb, serves the frozen clob_* surface over ZAP,
# and runs the consensus sealer loop (WaitForEvent->BuildBlock->Verify->Accept)
# so every write returns consensus-computed fills.
# ---------------------------------------------------------------------------
ARG GO_VERSION=1.26.4
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates && rm -rf /var/lib/apt/lists/*

# luxfi module resolution: private modules (corona etc.) via ghtok BuildKit
# secret over HTTPS; skip sumdb for luxfi (tags may be rewritten — go.sum in
# the build context is already realigned to current tag bits).
ENV GOPRIVATE=github.com/luxfi/*
ENV GOFLAGS=-mod=mod
ENV GOTOOLCHAIN=auto
ENV GOEXPERIMENT=jsonv2

WORKDIR /app
COPY go.mod go.sum ./
RUN --mount=type=secret,id=ghtok,required=false \
    if [ -s /run/secrets/ghtok ]; then \
        git config --global url."https://x-access-token:$(cat /run/secrets/ghtok)@github.com/".insteadOf "https://github.com/"; \
    fi && \
    go mod download
COPY . .

# CPU venue: CGO_ENABLED=0 → !cgo build tag → pure-Go CPU matcher.
RUN --mount=type=secret,id=ghtok,required=false \
    if [ -s /run/secrets/ghtok ]; then \
        git config --global url."https://x-access-token:$(cat /run/secrets/ghtok)@github.com/".insteadOf "https://github.com/"; \
    fi && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /out/dvenue ./cmd/dvenue

FROM debian:12-slim AS execution
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 venue && useradd -u 1000 -g venue -m -s /usr/sbin/nologin venue \
    && mkdir -p /data && chown -R venue:venue /data
COPY --from=builder /out/dvenue /usr/local/bin/dvenue
USER venue
EXPOSE 9099
# The deployment passes -addr 0.0.0.0:9099 -db /data/db.
ENTRYPOINT ["/usr/local/bin/dvenue"]
