  "repository": {
    "type": "git",
    "url": "https://github.com/luxfi/dex.git",
    "directory": "sdk/lx-trading-ts"
  },
  "homepage": "https://dex.lux.network",
  "dependencies": {
    "axios": "^1.6.0",
    "ccxt": "^4.2.0",
    "decimal.js": "^10.4.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
