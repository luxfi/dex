{
  "name": "@luxfi/trading",
  "version": "1.0.0",
  "description": "High-frequency trading SDK with unified liquidity aggregation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
