    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "node --test --experimental-test-coverage dist/**/*.test.js",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "trading",
    "dex",
    "amm",
    "ccxt",
    "orderbook",
    "hft",
