# syntax=docker/dockerfile:1
#
# dexkeeper — the off-chain keeper that drives the on-chain 0x9999 two-phase atomic
# DEX seam (watch IntentSubmitted -> dexvm ImportTx + RelayOrderTx via dex.submitTx ->
# poll dex.getSettlement -> C-side Phase-B settle -> DEXFill). Pure-Go (CGO disabled);
# the maker key is derived in-process from the LUX_MNEMONIC env (KMS-synced secret).
#
# BUILD DEP NOTE: the keeper imports github.com/luxfi/zap (>= v0.8.10, the
# EncodeIntentHookData/EncodeSettlementHookData calldata) and github.com/luxfi/chains
# (the dexvm txs + the dex.submitTx/getSettlement RPC server). Both tags must be cut
# before this image builds from published modules alone (go.work is NOT used in CI).
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder

RUN apk add --no-cache git ca-certificates

ENV GOPRIVATE=github.com/luxfi/*,github.com/hanzoai/*

WORKDIR /app
COPY go.mod go.sum ./
# Private cross-repo Go modules (luxfi/*): the reusable docker-build workflow
# exposes the org PAT as a BuildKit secret id=gh_token. Mount it for the module
# fetch only (never baked into a layer). ARG GITHUB_TOKEN remains a fallback for
# local `--build-arg` builds; the secret takes precedence when present.
ARG GITHUB_TOKEN
RUN --mount=type=secret,id=gh_token \
    TOKEN="$(cat /run/secrets/gh_token 2>/dev/null || echo "${GITHUB_TOKEN}")" && \
    if [ -n "$TOKEN" ]; then \
      git config --global url."https://${TOKEN}@github.com/".insteadOf "https://github.com/"; \
    fi && \
    go mod download
COPY . .

ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="-s -w" -o dexkeeper ./cmd/dexkeeper

FROM alpine:3.21

RUN apk add --no-cache ca-certificates && \
    addgroup -g 1000 -S keeper && \
    adduser -u 1000 -S keeper -G keeper

WORKDIR /home/keeper
COPY --from=builder /app/dexkeeper .
RUN chown keeper:keeper dexkeeper

USER keeper

# No ports: the keeper is an egress-only client (C-Chain RPC + dexvm RPC + venue ZAP).
ENTRYPOINT ["./dexkeeper"]
