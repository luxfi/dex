# dexd multi-node testnet — per-box configuration.
# Copy to `.env` on each box and edit. `.env` is git-ignored.
#
#   cp .env.example .env && $EDITOR .env
#
# Every value has a safe default baked into compose.yml / gen-compose.sh; you
# only NEED to set the two box IPs (and pick N).

# ---- node count ------------------------------------------------------------
# Venues to run on THIS box. Default 3. Scale to ~11 on a 128 GB box.
# Sizing rule of thumb (see README "Sizing"): N <= min(11, physical_cores/2),
# and NODE_MEM * N <= RAM - 16 GB.
N=3

# ---- image -----------------------------------------------------------------
# The testnet image (dexd + dexbench). `make build` builds it from this repo on
# the box (native arch). To use a CI-published image instead, set e.g.
# DEX_IMAGE=ghcr.io/luxfi/dex:sha-xxxxxxx (dexd only — `make bench` then needs
# the local image; prefer `make build`).
DEX_IMAGE=dexd-testnet:local

# ---- ports / binding -------------------------------------------------------
# Node i listens on host port BASE_PORT+i (container 9099). Default 9099 =>
# 9099,9100,9101,... BIND_ADDR is the host interface to publish on; 0.0.0.0 makes
# venues reachable from the OTHER box over the 2.5 GbE LAN (open the firewall for
# BASE_PORT..BASE_PORT+N-1). Use 127.0.0.1 for a single-box local run.
BASE_PORT=9099
BIND_ADDR=0.0.0.0

# ---- per-node resource limits ----------------------------------------------
# Sized for a 128 GB box. Tune down if you raise N. (Compose honors these via
# deploy.resources.limits in `docker compose up`.)
NODE_MEM=6g
NODE_CPUS=4.0

# ---- the two boxes (REQUIRED for cross-box bench/verify) -------------------
# LAN IPs of the boxes on the 2.5 GbE link. ONLY YOU KNOW THESE — fill them in.
# Used by `make bench` / `make verify` to build the -addrs endpoint list.
EVO_IP=
SPARK_IP=
# Optional third box (e.g. ra). Leave empty if unused.
RA_IP=

# ---- bench knobs (make bench) ----------------------------------------------
BENCH_CONNS=32
BENCH_MARKETS=4
BENCH_DURATION=30s
BENCH_WARMUP=3s
BENCH_OP=place        # place (resting write, sustainable) | cross (place+submit)
