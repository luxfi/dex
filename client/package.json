{
  "name": "@luxexchange/lx-client",
  "version": "1.0.0",
  "description": "Lux Exchange TypeScript Client Library - High-performance trading client for DEX and CEX",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lux",
    "exchange",
    "trading",
    "dex",
    "cex",
    "orderbook",
    "crypto",
    "stocks",
    "securities"
  ],
  "author": "Lux Exchange",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "decimal.js": "^10.6.0",
    "eventemitter3": "^5.0.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/luxexchange/lx-client-ts"
  },
  "bugs": {
    "url": "https://github.com/luxexchange/lx-client-ts/issues"
  },
  "homepage": "https://luxexchange.io"
}
